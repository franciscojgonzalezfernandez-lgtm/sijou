# Copy to .env.local and fill in. Never commit real values.

# Postgres connection string. Local: docker compose up -d (see docker-compose.yml).
# Vercel: set by the Neon integration (pooled connection).
DATABASE_URL=postgresql://sijou:sijou@localhost:54329/sijou

# Payload secret, at least 32 characters, different per environment.
# Generate one with: openssl rand -base64 48
PAYLOAD_SECRET=

# Canonical site URL. Local runs use port 3100 (dev, start, E2E). Payload only trusts this origin
# for cookie-authenticated writes (CSRF), so it must match the port you open.
# Optional on Vercel previews (derived from VERCEL_URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Only for `pnpm seed` (local test administrator).
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=

# Vercel Blob token for product photos (F-010). Set by Vercel on deployments.
# Leave empty locally: uploads then go to media/ on disk.
BLOB_READ_WRITE_TOKEN=
